import P3.CoordinateJetIdeals

/-!
# The P3 finite hidden filtration and formal-coordinate jet ideals

This module uses the original, unchanged P3 hidden filtration and
`hidden_eq_span_primitive` to characterize each off-diagonal
coordinate of `hidden φ k` by the Taylor coefficients of a canonical
formal series. The series has coefficient Q(φ^n d) / n!, so it is
the formal exponential orbit's off-diagonal coordinate.

No analytic convergence, CP semigroup, infinite-dimensional limit,
non-cancellation of the divergence, or P11 completeness is claimed.
-/

noncomputable section

namespace P3

section HiddenJetBridge

variable {V : Type*} [Fintype V] [DecidableEq V]

/-- A complex-linear matrix coordinate functional. -/
def matrixCoordinate (x y : V) : A V →ₗ[ℂ] ℂ where
  toFun z := z x y
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- Coordinate of the formal off-diagonal exponential orbit,
with nth coefficient (Q φ^n d)_(x,y) / n!. -/
def p3HiddenCoordinateJet (φ : Dynamics V)
    (d : diagonalSubmodule (V := V)) (x y : V) : PowerSeries ℂ :=
  PowerSeries.mk (fun n =>
    (primitiveDefect (V := V) φ n d).1 x y *
      ((Nat.factorial n : ℂ)⁻¹))

@[simp]
theorem p3HiddenCoordinateJet_coeff
    (φ : Dynamics V) (d : diagonalSubmodule (V := V))
    (x y : V) (n : ℕ) :
    (PowerSeries.coeff n) (p3HiddenCoordinateJet φ d x y) =
      (primitiveDefect (V := V) φ n d).1 x y *
        ((Nat.factorial n : ℂ)⁻¹) := by
  simp [p3HiddenCoordinateJet]

/-- Factorial normalization does not alter coordinate support. -/
theorem p3HiddenCoordinateJet_coeff_ne_zero_iff
    (φ : Dynamics V) (d : diagonalSubmodule (V := V))
    (x y : V) (n : ℕ) :
    (PowerSeries.coeff n) (p3HiddenCoordinateJet φ d x y) ≠ 0 ↔
      (primitiveDefect (V := V) φ n d).1 x y ≠ 0 := by
  rw [p3HiddenCoordinateJet_coeff]
  have hfac : ((Nat.factorial n : ℂ)⁻¹) ≠ 0 := by
    apply inv_ne_zero
    exact_mod_cast Nat.factorial_ne_zero n
  exact (mul_ne_zero_iff).trans (and_iff_left hfac)

/-- A P3 hidden-defect coordinate is nonzero precisely when some
depth-≤k primitive generator has a nonzero coordinate there. -/
theorem defectActive_iff_exists_primitiveCoordinate
    (φ : Dynamics V) (k : ℕ) (x y : V) :
    defectActive φ k x y ↔
      x ≠ y ∧
        ∃ d : diagonalSubmodule (V := V), ∃ n : ℕ,
          n ≤ k ∧ (primitiveDefect (V := V) φ n d).1 x y ≠ 0 := by
  constructor
  · rintro ⟨hxy, z, hz, hznonzero⟩
    by_contra hnone
    have hzero : ∀ d : diagonalSubmodule (V := V),
        ∀ n : ℕ, n ≤ k →
          (primitiveDefect (V := V) φ n d).1 x y = 0 := by
      intro d n hn
      by_contra hnonzero
      exact hnone ⟨hxy, d, n, hn, hnonzero⟩
    have hker : primitiveHiddenSpan (V := V) φ k ≤
        LinearMap.ker (matrixCoordinate x y) := by
      apply Submodule.span_le.mpr
      intro v hv
      rcases hv with ⟨d, n, hn, rfl⟩
      change (primitiveDefect (V := V) φ n d).1 x y = 0
      exact hzero d n hn
    have hzspan : z ∈ primitiveHiddenSpan (V := V) φ k := by
      rw [← hidden_eq_span_primitive (V := V) φ k]
      exact hz
    have hz0 : z x y = 0 := hker hzspan
    exact hznonzero hz0
  · rintro ⟨hxy, d, n, hn, hnonzero⟩
    refine ⟨hxy, (primitiveDefect (V := V) φ n d).1, ?_, hnonzero⟩
    exact primitiveDefect_mem_hidden (V := V) φ hn d

/-- Each finite-depth hidden defect is seen by a nonzero coefficient in
the associated family of formal Taylor series, and conversely. -/
theorem defectActive_iff_exists_p3HiddenJet
    (φ : Dynamics V) (k : ℕ) (x y : V) :
    defectActive φ k x y ↔
      x ≠ y ∧
        ∃ d : diagonalSubmodule (V := V), ∃ n : ℕ,
          n ≤ k ∧
          (PowerSeries.coeff n) (p3HiddenCoordinateJet φ d x y) ≠ 0 := by
  rw [defectActive_iff_exists_primitiveCoordinate]
  constructor
  · rintro ⟨hxy, d, n, hn, hne⟩
    exact ⟨hxy, d, n, hn,
      (p3HiddenCoordinateJet_coeff_ne_zero_iff φ d x y n).mpr hne⟩
  · rintro ⟨hxy, d, n, hn, hne⟩
    exact ⟨hxy, d, n, hn,
      (p3HiddenCoordinateJet_coeff_ne_zero_iff φ d x y n).mp hne⟩

/-- Exact P3-versus-formal-series bridge for any off-diagonal coordinate:
a coordinate is active at finite depth k if and only if the ideal
generated by the canonical formal seed trajectories does NOT lie in
the next jet ideal (τ^(k+1)). -/
theorem defectActive_iff_coordinateJetIdeal_not_le
    (φ : Dynamics V) (k : ℕ) (x y : V) (hxy : x ≠ y) :
    defectActive φ k x y ↔
      ¬ coordinateJetIdeal
        (fun d : diagonalSubmodule (V := V) =>
          p3HiddenCoordinateJet φ d x y) ≤ jetIdeal (k + 1) := by
  constructor
  · intro hactive hle
    obtain ⟨_, d, n, hn, hnonzero⟩ :=
      (defectActive_iff_exists_p3HiddenJet φ k x y).mp hactive
    have hgen : p3HiddenCoordinateJet φ d x y ∈ jetIdeal (k + 1) :=
      (coordinateJetIdeal_le_jetIdeal_iff _ _).mp hle d
    have hzero := (mem_jetIdeal_iff _ _).mp hgen n (Nat.lt_succ_of_le hn)
    exact hnonzero hzero
  · intro hnot
    by_contra hnone
    apply hnot
    apply (coordinateJetIdeal_le_jetIdeal_iff _ _).mpr
    intro d
    apply (mem_jetIdeal_iff _ _).mpr
    intro n hn
    by_contra hnonzero
    apply hnone
    apply (defectActive_iff_exists_p3HiddenJet φ k x y).mpr
    exact ⟨hxy, d, n, Nat.le_of_lt_succ hn, hnonzero⟩

/-- A finite P3 support-graph edge is equivalent to failure of
high-order vanishing for one of its two oriented coordinate ideals.
This needs no graph saturation or genericity condition. -/
theorem supportGraph_adj_iff_coordinateJetIdeal_not_le
    (φ : Dynamics V) (k : ℕ) (x y : V) :
    (supportGraph φ k).Adj x y ↔
      (¬ coordinateJetIdeal
        (fun d : diagonalSubmodule (V := V) =>
          p3HiddenCoordinateJet φ d x y) ≤ jetIdeal (k / 2 + 1)) ∨
      (¬ coordinateJetIdeal
        (fun d : diagonalSubmodule (V := V) =>
          p3HiddenCoordinateJet φ d y x) ≤ jetIdeal (k / 2 + 1)) := by
  rw [supportGraph_eq_defectSupportGraph (V := V) φ k]
  change (defectActive φ (k / 2) x y ∨ defectActive φ (k / 2) y x) ↔ _
  constructor
  · rintro (h | h)
    · exact Or.inl ((defectActive_iff_coordinateJetIdeal_not_le φ
          (k / 2) x y h.1).mp h)
    · exact Or.inr ((defectActive_iff_coordinateJetIdeal_not_le φ
          (k / 2) y x h.1).mp h)
  · rintro (h | h)
    · by_cases hxy : x = y
      · subst y
        exfalso
        apply h
        apply (coordinateJetIdeal_le_jetIdeal_iff _ _).mpr
        intro d
        apply (mem_jetIdeal_iff _ _).mpr
        intro n hn
        simp [p3HiddenCoordinateJet_coeff, offDiag_diag_zero]
      · exact Or.inl ((defectActive_iff_coordinateJetIdeal_not_le φ
          (k / 2) x y hxy).mpr h)
    · by_cases hxy : y = x
      · subst y
        exfalso
        apply h
        apply (coordinateJetIdeal_le_jetIdeal_iff _ _).mpr
        intro d
        apply (mem_jetIdeal_iff _ _).mpr
        intro n hn
        simp [p3HiddenCoordinateJet_coeff, offDiag_diag_zero]
      · exact Or.inr ((defectActive_iff_coordinateJetIdeal_not_le φ
          (k / 2) y x hxy).mpr h)

end HiddenJetBridge

end P3
