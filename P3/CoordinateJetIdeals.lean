import P3.JetPowerSeries

/-!
# Coordinate ideals and quadratic hidden-flow ideals over complex formal jets

For an indexed family of formal series `f : ι → ℂ⟦T⟧`, the coordinate
ideal is generated by all f_i, while the quadratic hidden-flow ideal
is generated by all pairs f_i * (coefficientwise conjugate f_j).

Under the sharp lower-depth hypothesis, both ideal filtrations have
exact known first nonzero degrees. These statements are valid for
arbitrary indexing types; finiteness is only needed if one wants
to obtain the minimum order from a nonempty finite family without
supplying a sharp witness.

No P3 divergence noncancellation or physical accessibility is assumed.
-/

noncomputable section

namespace P3

section CoordinateJetIdeals

variable {ι : Type*}

/-- Ideal generated by the formal-jet coordinate family. -/
def coordinateJetIdeal (f : ι → PowerSeries ℂ) : Ideal (PowerSeries ℂ) :=
  Ideal.span (Set.range f)

/-- Ideal generated by all self- and cross-Hadamard formal flow coordinates. -/
def quadraticJetIdeal (f : ι → PowerSeries ℂ) : Ideal (PowerSeries ℂ) :=
  Ideal.span (Set.range (fun p : ι × ι => f p.1 * jetConjugate (f p.2)))

/-- Coordinate-ideal filtration is equivalent to the uniform lower-order
bound on its generators. -/
theorem coordinateJetIdeal_le_jetIdeal_iff (f : ι → PowerSeries ℂ) (r : ℕ) :
    coordinateJetIdeal f ≤ jetIdeal r ↔ ∀ i, f i ∈ jetIdeal r := by
  rw [coordinateJetIdeal, Ideal.span_le]
  constructor
  · intro h i
    exact h (Set.mem_range_self i)
  · intro h g hg
    rcases hg with ⟨i, rfl⟩
    exact h i

/-- Coefficientwise conjugation preserves membership in the r-th jet ideal. -/
theorem jetConjugate_mem_jetIdeal
    (f : PowerSeries ℂ) (r : ℕ) (hf : f ∈ jetIdeal r) :
    jetConjugate f ∈ jetIdeal r := by
  apply (mem_jetIdeal_iff _ _).mpr
  intro n hn
  rw [jetConjugate_coeff]
  simp [(mem_jetIdeal_iff _ _).mp hf n hn]

/-- Products of two series with order at least r lie in the
2r-th jet ideal. -/
theorem jetPairFlow_mem_doubled_ideal
    (f g : PowerSeries ℂ) (r : ℕ)
    (hf : f ∈ jetIdeal r) (hg : g ∈ jetIdeal r) :
    f * jetConjugate g ∈ jetIdeal (2 * r) := by
  have h₁ : (r : ℕ∞) ≤ f.order :=
    (mem_jetIdeal_iff_order _ _).mp hf
  have h₂ : (r : ℕ∞) ≤ (jetConjugate g).order :=
    (mem_jetIdeal_iff_order _ _).mp
      (jetConjugate_mem_jetIdeal g r hg)
  apply (mem_jetIdeal_iff_order _ _).mpr
  calc
    ((2 * r : ℕ) : ℕ∞) = (r : ℕ∞) + (r : ℕ∞) := by
      simp [two_mul, Nat.cast_add]
    _ ≤ f.order + (jetConjugate g).order := add_le_add h₁ h₂
    _ ≤ (f * jetConjugate g).order :=
      PowerSeries.le_order_mul f (jetConjugate g)

/-- Every cross-product in the hidden-flow ideal has depth at least 2r. -/
theorem quadraticJetIdeal_le_doubled
    (f : ι → PowerSeries ℂ) (r : ℕ)
    (hall : ∀ i, f i ∈ jetIdeal r) :
    quadraticJetIdeal f ≤ jetIdeal (2 * r) := by
  apply Ideal.span_le.mpr
  intro x hx
  rcases hx with ⟨p, rfl⟩
  exact jetPairFlow_mem_doubled_ideal
    (f p.1) (f p.2) r (hall p.1) (hall p.2)

/-- Sharpness of the generator's lower bound means its r-th coefficient
is nonzero (so its order is exactly r). -/
theorem coordinateGenerator_order_eq
    (f : ι → PowerSeries ℂ) (r : ℕ)
    (hall : ∀ i, f i ∈ jetIdeal r)
    (i : ι) (hsharp : f i ∉ jetIdeal (r + 1)) :
    (f i).order = (r : ℕ∞) := by
  have hbefore : ∀ n : ℕ, n < r → (PowerSeries.coeff n) (f i) = 0 :=
    (mem_jetIdeal_iff _ _).mp (hall i)
  have hleading : (PowerSeries.coeff r) (f i) ≠ 0 := by
    intro hzero
    apply hsharp
    apply (mem_jetIdeal_iff _ _).mpr
    intro n hn
    have hle : n ≤ r := Nat.lt_succ_iff.mp hn
    rcases lt_or_eq_of_le hle with hl | he
    · exact hbefore n hl
    · simpa [he] using hzero
  exact (PowerSeries.order_eq_nat).mpr ⟨hleading, hbefore⟩

/-- The family coordinate ideal has a sharp leading depth r. -/
theorem coordinateJetIdeal_not_le_next
    (f : ι → PowerSeries ℂ) (r : ℕ)
    (i : ι) (hsharp : f i ∉ jetIdeal (r + 1)) :
    ¬ coordinateJetIdeal f ≤ jetIdeal (r + 1) := by
  intro hle
  apply hsharp
  apply hle
  exact Ideal.subset_span (Set.mem_range_self i)

/-- The full quadratic hidden-flow ideal has exact first depth 2r,
even with arbitrary cross terms and possible cancellation among them:
the self-product of any sharp witness cannot be cancelled out of
an ideal containing its generators. -/
theorem quadraticJetIdeal_not_le_next
    (f : ι → PowerSeries ℂ) (r : ℕ)
    (hall : ∀ i, f i ∈ jetIdeal r)
    (i : ι) (hsharp : f i ∉ jetIdeal (r + 1)) :
    ¬ quadraticJetIdeal f ≤ jetIdeal (2 * r + 1) := by
  intro hle
  have hi : (f i).order = (r : ℕ∞) :=
    coordinateGenerator_order_eq f r hall i hsharp
  have hself : f i * jetConjugate (f i) ∈ quadraticJetIdeal f :=
    Ideal.subset_span (Set.mem_range_self (i, i))
  exact (jetSelfFlow_not_mem_next_ideal (f i) r hi) (hle hself)

/-- Sharp coordinate filtration plus sharp self-Hadamard doubled filtration. -/
theorem coordinateAndQuadraticIdeal_depth_pair
    (f : ι → PowerSeries ℂ) (r : ℕ)
    (hall : ∀ i, f i ∈ jetIdeal r)
    (i : ι) (hsharp : f i ∉ jetIdeal (r + 1)) :
    (coordinateJetIdeal f ≤ jetIdeal r ∧
      ¬ coordinateJetIdeal f ≤ jetIdeal (r + 1)) ∧
    (quadraticJetIdeal f ≤ jetIdeal (2 * r) ∧
      ¬ quadraticJetIdeal f ≤ jetIdeal (2 * r + 1)) := by
  exact ⟨⟨(coordinateJetIdeal_le_jetIdeal_iff f r).mpr hall,
            coordinateJetIdeal_not_le_next f r i hsharp⟩,
          ⟨quadraticJetIdeal_le_doubled f r hall,
            quadraticJetIdeal_not_le_next f r hall i hsharp⟩⟩

end CoordinateJetIdeals

end P3
