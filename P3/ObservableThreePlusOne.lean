import P3.InvariantInvisibleSector

/-!
# Phase 6.A: exact reachable symmetric plane and 3+1 splitting

For the single-unitary reflection channel, the diagonal-seed reachable
P3 Krylov submodule is exactly the transpose-symmetric complex 3-plane.

The full 2x2 algebra decomposes, as a vector space, into an observed
symmetric matrix and a scalar multiple of the skew eigenvector J.
This is a finite observer-relative linear statement; it does not
identify the P3 hidden defect with the inaccessible skew line.
-/

noncomputable section

namespace P3

/-- A non-diagonal symmetric direction generated by the first orbit. -/
def p3ReflectionSymmetricK : A (Fin 2) :=
  !![(0 : ℂ), 1;
     1, 0]

/-- K=E01+E10 belongs to the actual P3 diagonal-seed Krylov space. -/
theorem p3ReflectionSymmetricK_observable :
    p3ReflectionSymmetricK ∈
      p3ObservableKrylovSpace p3RationalReflectionChannel := by
  let E0 : A (Fin 2) :=
    Matrix.single (0 : Fin 2) (0 : Fin 2) (1 : ℂ)
  let E1 : A (Fin 2) :=
    Matrix.single (1 : Fin 2) (1 : Fin 2) (1 : ℂ)
  have h0 : E0 ∈ p3ObservableKrylovSpace p3RationalReflectionChannel := by
    have hd :
        (p3CanonicalDiagonalBasis (V := Fin 2) (0 : Fin 2)).1 ∈
          p3ObservableKrylovSpace p3RationalReflectionChannel :=
      p3ObservableKrylovSpace_contains_diagonal
        p3RationalReflectionChannel
        (p3CanonicalDiagonalBasis (V := Fin 2) (0 : Fin 2)).property
    simpa [E0, p3CanonicalDiagonalBasis_apply] using hd
  have h1 : E1 ∈ p3ObservableKrylovSpace p3RationalReflectionChannel := by
    have hd :
        (p3CanonicalDiagonalBasis (V := Fin 2) (1 : Fin 2)).1 ∈
          p3ObservableKrylovSpace p3RationalReflectionChannel :=
      p3ObservableKrylovSpace_contains_diagonal
        p3RationalReflectionChannel
        (p3CanonicalDiagonalBasis (V := Fin 2) (1 : Fin 2)).property
    simpa [E1, p3CanonicalDiagonalBasis_apply] using hd
  have hstep : p3RationalReflectionChannel E0 ∈
      p3ObservableKrylovSpace p3RationalReflectionChannel :=
    p3ObservableKrylovSpace_invariant p3RationalReflectionChannel h0
  have hEq :
      p3ReflectionSymmetricK =
        (25 / 12 : ℂ) •
          (p3RationalReflectionChannel E0 -
            (9 / 25 : ℂ) • E0 - (16 / 25 : ℂ) • E1) := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      norm_num [p3ReflectionSymmetricK,
        p3RationalReflectionChannel_apply,
        p3RationalReflectionU, E0, E1,
        Matrix.mul_apply, Matrix.vecMul, dotProduct,
        Fin.sum_univ_two, Matrix.single_apply,
        Matrix.sub_apply, Matrix.smul_apply]
  rw [hEq]
  exact (p3ObservableKrylovSpace p3RationalReflectionChannel).smul_mem
    (25 / 12 : ℂ)
    ((p3ObservableKrylovSpace p3RationalReflectionChannel).sub_mem
      ((p3ObservableKrylovSpace p3RationalReflectionChannel).sub_mem
        hstep
        ((p3ObservableKrylovSpace p3RationalReflectionChannel).smul_mem
          (9 / 25 : ℂ) h0))
      ((p3ObservableKrylovSpace p3RationalReflectionChannel).smul_mem
        (16 / 25 : ℂ) h1))

/-- Exact equality: the original P3 observable closure is the symmetric plane. -/
theorem p3Reflection_observable_eq_symmetric :
    p3ObservableKrylovSpace p3RationalReflectionChannel =
      p3ReflectionSymmetric := by
  apply le_antisymm
  · exact p3Reflection_observable_le_symmetric
  · intro M hM
    have hSym : M 0 1 = M 1 0 := hM
    let E0 : A (Fin 2) :=
      Matrix.single (0 : Fin 2) (0 : Fin 2) (1 : ℂ)
    let E1 : A (Fin 2) :=
      Matrix.single (1 : Fin 2) (1 : Fin 2) (1 : ℂ)
    have h0 : E0 ∈ p3ObservableKrylovSpace p3RationalReflectionChannel := by
      have hd :
          (p3CanonicalDiagonalBasis (V := Fin 2) (0 : Fin 2)).1 ∈
            p3ObservableKrylovSpace p3RationalReflectionChannel :=
        p3ObservableKrylovSpace_contains_diagonal
          p3RationalReflectionChannel
          (p3CanonicalDiagonalBasis (V := Fin 2) (0 : Fin 2)).property
      simpa [E0, p3CanonicalDiagonalBasis_apply] using hd
    have h1 : E1 ∈ p3ObservableKrylovSpace p3RationalReflectionChannel := by
      have hd :
          (p3CanonicalDiagonalBasis (V := Fin 2) (1 : Fin 2)).1 ∈
            p3ObservableKrylovSpace p3RationalReflectionChannel :=
        p3ObservableKrylovSpace_contains_diagonal
          p3RationalReflectionChannel
          (p3CanonicalDiagonalBasis (V := Fin 2) (1 : Fin 2)).property
      simpa [E1, p3CanonicalDiagonalBasis_apply] using hd
    have hrepr :
        M = (M 0 0) • E0 +
            (M 1 1) • E1 +
            (M 0 1) • p3ReflectionSymmetricK := by
      ext i j
      fin_cases i <;> fin_cases j <;>
        simp [E0, E1, p3ReflectionSymmetricK,
          Matrix.add_apply, Matrix.smul_apply, Matrix.single_apply, hSym]
    rw [hrepr]
    exact (p3ObservableKrylovSpace p3RationalReflectionChannel).add_mem
      ((p3ObservableKrylovSpace p3RationalReflectionChannel).add_mem
        ((p3ObservableKrylovSpace p3RationalReflectionChannel).smul_mem
          (M 0 0) h0)
        ((p3ObservableKrylovSpace p3RationalReflectionChannel).smul_mem
          (M 1 1) h1))
      ((p3ObservableKrylovSpace p3RationalReflectionChannel).smul_mem
        (M 0 1) p3ReflectionSymmetricK_observable)

/-- Every complex 2x2 matrix has an observed + skew decomposition. -/
theorem p3Reflection_observed_plus_skew (M : A (Fin 2)) :
    ∃ S : A (Fin 2),
      S ∈ p3ObservableKrylovSpace p3RationalReflectionChannel ∧
      ∃ c : ℂ, M = S + c • p3ReflectionSkewJ := by
  let c : ℂ := (M 0 1 - M 1 0) / 2
  let S : A (Fin 2) := M - c • p3ReflectionSkewJ
  have hS : S ∈ p3ReflectionSymmetric := by
    change S 0 1 = S 1 0
    dsimp [S, c]
    simp [Matrix.sub_apply, Matrix.smul_apply, p3ReflectionSkewJ]
    ring
  have hSobs : S ∈ p3ObservableKrylovSpace p3RationalReflectionChannel := by
    rw [p3Reflection_observable_eq_symmetric]
    exact hS
  refine ⟨S, hSobs, c, ?_⟩
  dsimp [S]
  abel

/-- No nonzero scalar multiple of J is reachable from diagonal seeds. -/
theorem p3Reflection_skew_scalar_only_zero
    (c : ℂ)
    (h : c • p3ReflectionSkewJ ∈
      p3ObservableKrylovSpace p3RationalReflectionChannel) : c = 0 := by
  have hs := p3Reflection_observable_le_symmetric h
  change (c • p3ReflectionSkewJ) 0 1 =
    (c • p3ReflectionSkewJ) 1 0 at hs
  have heq : c = -c := by
    simpa [Matrix.smul_apply, p3ReflectionSkewJ] using hs
  have hz : (2 : ℂ) * c = 0 := by
    linear_combination heq
  exact (mul_eq_zero.mp hz).resolve_left (by norm_num)

end P3
